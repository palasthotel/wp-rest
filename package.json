{
  "name": "@palasthotel/wp-rest",
  "version": "1.0.2",
  "description": "Zod schemas, types and request builders for the WordPress REST API.",
  "keywords": [
    "wordpress",
    "wp-json",
    "rest-api",
    "zod",
    "typescript"
  ],
  "homepage": "https://github.com/palasthotel/wp-rest#readme",
  "bugs": {
    "url": "https://github.com/palasthotel/wp-rest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palasthotel/wp-rest.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Palasthotel",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
